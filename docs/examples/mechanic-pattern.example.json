        { "target": { "role": "MT" }, "marker": "spread" },
        { "target": { "role": "ST" }, "marker": "spread" },
        { "target": { "role": "H1" }, "marker": "stack" },
        { "target": { "role": "H2" }, "marker": "spread" },
        { "target": { "role": "D1" }, "marker": "spread" },
        { "target": { "role": "D2" }, "marker": "spread" },
        { "target": { "role": "D3" }, "marker": "spread" },
        { "target": { "role": "D4" }, "marker": "spread" }
      ]
    },
    {
      "at": 2,
      "type": "spawn_aoe",
